# ---------------------------------------------------------------------------
# BlackOut Internet Downloader — configuration
# Copy to .env and fill in. On GitHub Actions these come from repo
# Settings → Secrets and variables → Actions instead.
# ---------------------------------------------------------------------------

# --- required ---------------------------------------------------------------
# Get this from https://rubika.ir/BotFather. It is one opaque token; paste it
# exactly, with no surrounding spaces or quotes.
RUBIKA_BOT_TOKEN=your_token_from_botfather

# --- optional: access control ----------------------------------------------
# By default the bot is OPEN: anyone who starts it can use it.
# Set ALLOWED_USERS to restrict it to a list of Rubika user ids.
ADMIN_IDS=
ALLOWED_USERS=
BLOCKED_USERS=
# Allow the bot to work in group chats (default true).
ALLOW_GROUPS=true

# --- optional: engine -------------------------------------------------------
# Proxy for yt-dlp, e.g. socks5://127.0.0.1:1080
PROXY=
# Proxy the bot uses to reach botapi.rubika.ir itself. Rubika drops connections
# from most networks outside Iran (GitHub runners, most foreign VPSes), so if
# this machine cannot reach Rubika directly, point this at a proxy whose exit
# can — e.g. socks5://iranian-vps:1080. Falls back to PROXY when empty.
RUBIKA_API_PROXY=
# Path to a Netscape-format cookies.txt (for age-gated / private media).
COOKIES_FILE=
# Or a URL the bot downloads cookies from at startup.
COOKIES_URL=
MAX_CONCURRENT_DOWNLOADS=2

# --- optional: limits (bytes unless noted) ---------------------------------
# Rubika caps uploads at 50 MiB (File/Video) and 10 MiB (Image).
MAX_UPLOAD_SIZE=52428800
MAX_IMAGE_SIZE=10485760
# Largest source file we are willing to download before splitting (4 GiB).
MAX_FILESIZE=4294967296
MAX_PLAYLIST_ITEMS=25
# Split files larger than the upload ceiling into parts (requires ffmpeg).
SPLIT_ENABLED=true
SPLIT_TARGET_SIZE=47185920

# --- optional: behaviour ----------------------------------------------------
DELETE_AFTER_UPLOAD=true
EDIT_PROGRESS_INTERVAL=6
LOG_LEVEL=INFO
# LOG_FILE=./logs/bot.log

# --- optional: runner -------------------------------------------------------
# How long a GitHub Actions run works before handing off (minutes).
RUN_MINUTES=330
